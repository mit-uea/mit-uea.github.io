<div class="news" style="margin-top: 3rem; padding: 25px 30px; background: #f8f9fc; border-radius: 12px; box-shadow: 0 3px 10px rgba(0,0,0,0.08);">

  <h2 style="color: #A31F34; font-size: 1.8rem; margin-top: 0; margin-bottom: 1rem; font-weight: 700;">
    Latest News
  </h2>

  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div class="table-responsive" {% if include.limit and site.announcements.scrollable and news_size > 3 %}style="max-height: 60vw; overflow-y: auto;"{% endif %}>
      <table class="table table-sm table-borderless" style="margin-bottom: 0;">
        {% assign news = site.news | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}

        {% for item in news limit: news_limit %}
          <tr style="border-bottom: 1px solid #e2e5ea;">
            <th scope="row" style="width: 20%; color:#555; font-weight: 500; vertical-align: top; padding-top: 0.5rem;">
              {{ item.date | date: '%b %d, %Y' }}
            </th>
            <td style="padding-top: 0.5rem; vertical-align: top;">
              {% if item.inline %}
                <span style="color:#333;">{{ item.content | remove: '<p>' | remove: '</p>' | emojify }}</span>
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}" style="color:#2a45d8; font-weight: 600; text-decoration: none;">
                  {{ item.title }}
                </a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p style="color:#555; font-style: italic;">No news so far...</p>
  {% endif %}

  <div style="margin-top: 1rem;">
    <a href="/news/" style="color:#A31F34; font-weight: 600; text-decoration: underline;">See all news →</a>
  </div>

</div>


